#!/usr/bin/env python3
"""Publish StatusNotifierItem tray icons for apps that don't ship one.

Each app gets a real system-tray item with an "Open <app>" / "Quit <app>" menu,
so the Quickshell bar treats it like any other tray app (including the Pin/Unpin
entry the shell adds itself). The item is only shown while the app is running:
the status is polled and set to Passive when it is not, which the shell hides.

Started by config/systemd/user/app-tray-shortcuts.service.
"""

import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import GLib, Gtk, AyatanaAppIndicator3  # noqa: E402

HOME = os.path.expanduser("~")

# name: menu label / tooltip
# icon: icon-theme name
# launch: argv used to open/focus the app
# quit: pkill -f patterns used to stop it
APPS = [
    {
        "id": "t3code-tray",
        "name": "T3 Code",
        "icon": "t3code-nightly",
        "launch": ["/opt/t3code-nightly-bin/t3code"],
        "quit": ["/opt/t3code-nightly-bin/t3code"],
    },
    {
        "id": "hermes-tray",
        "name": "Hermes",
        "icon": "hermes",
        "launch": [f"{HOME}/.local/bin/hermes", "desktop", "--skip-build"],
        "quit": ["hermes desktop", "hermes-agent/apps/desktop"],
    },
    {
        "id": "zcode-tray",
        "name": "ZCode",
        "icon": "zcode",
        "launch": ["/usr/bin/zcode"],
        "quit": ["/opt/ZCode/zcode"],
    },
]


def launch(app):
    try:
        subprocess.Popen(
            app["launch"],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as error:
        print(f"app-tray-shortcuts: cannot launch {app['name']}: {error}", file=sys.stderr)


def quit_app(app):
    for pattern in app["quit"]:
        subprocess.run(
            ["pkill", "-f", pattern],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def is_running(app):
    for pattern in app["quit"]:
        result = subprocess.run(
            ["pgrep", "-f", pattern],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if result.returncode == 0:
            return True
    return False


def build_indicator(app):
    indicator = AyatanaAppIndicator3.Indicator.new(
        app["id"], app["icon"], AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS
    )
    indicator.set_status(
        AyatanaAppIndicator3.IndicatorStatus.ACTIVE
        if is_running(app)
        else AyatanaAppIndicator3.IndicatorStatus.PASSIVE
    )
    indicator.set_title(app["name"])

    menu = Gtk.Menu()

    open_item = Gtk.MenuItem(label=f"Open {app['name']}")
    open_item.connect("activate", lambda _item, a=app: launch(a))
    menu.append(open_item)

    quit_item = Gtk.MenuItem(label=f"Quit {app['name']}")
    quit_item.connect("activate", lambda _item, a=app: quit_app(a))
    menu.append(quit_item)

    menu.show_all()
    indicator.set_menu(menu)
    indicator.set_secondary_activate_target(open_item)
    return indicator


def refresh_status(indicators):
    for indicator, app in indicators:
        indicator.set_status(
            AyatanaAppIndicator3.IndicatorStatus.ACTIVE
            if is_running(app)
            else AyatanaAppIndicator3.IndicatorStatus.PASSIVE
        )
    return True


def main():
    # Keep references alive for the lifetime of the process.
    indicators = [(build_indicator(app), app) for app in APPS]
    if not indicators:
        return 1
    GLib.timeout_add_seconds(3, refresh_status, indicators)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
