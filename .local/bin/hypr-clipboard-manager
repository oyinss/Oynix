#!/usr/bin/env bash
# Hyprland Clipboard Manager GUI.
#
# With the persistent daemon (hypr-clipboard-manager.service) running, this
# activates the live instance via D-Bus so it toggles instantly, mirroring how
# swaync-client toggles the swaync daemon. Falls back to a cold start (or
# --daemon mode) when no instance is registered.

APP_ID="org.hypr.ClipboardManager"
OBJ="/org/hypr/ClipboardManager"
APP="$(readlink -f "$0" || echo "$0")"

# --daemon is only used by the systemd unit: start hidden and keep running.
if [[ "${1:-}" == "--daemon" ]]; then
    exec python3 "$HOME/.local/share/hypr-clipboard-manager/app.py" --daemon
fi

# Fast path: if an instance already owns the bus, just activate it.
if busctl --user status "$APP_ID" >/dev/null 2>&1; then
    busctl --user call "$APP_ID" "$OBJ" org.freedesktop.Application Activate a{sv} 0 2>/dev/null
    exit 0
fi

# Slow fallback: no daemon running, start fresh.
exec python3 "$HOME/.local/share/hypr-clipboard-manager/app.py" "$@"
