{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  "height": 50,
  "margin": "0 0 0 0",
  //"width": 1350, // Waybar width
  // Choose the order of the modules idle_inhibitor
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "tray",
    "hyprland/submap",
    "custom/cava-internal"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "backlight",
    "custom/network-down",
    "custom/network-up",
    "custom/bluetooth",
    "pulseaudio",
    "temperature",
    "group/hardware",
    "battery",
    "custom/codexbar",
    "custom/network",
    "idle_inhibitor",
    "custom/power"
  ],


    // Load Modules
    "include": ["~/.config/waybar/modules.json"],

  // Modules configuration

}
